<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        android:id="@+id/engine_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ai_setting_initializing_engine"
        android:textAppearance="?attr/textAppearanceBody2"
        android:layout_marginTop="8dp"/>
    <TextView
        android:id="@+id/model_status_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBody1"
        android:textAlignment="center"
        android:layout_marginBottom="8dp"
        tools:text="✅ Model loaded successfully!" />

    <TextView
        android:id="@+id/selected_model_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/local_model_not_selected"
        android:textAppearance="?attr/textAppearanceBody2"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:paddingBottom="8dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_browse_model"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/browse_local_model" />

    <Button
        android:id="@+id/loadSavedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:enabled="false"
        android:text="@string/load_saved_model"
        tools:enabled="true" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/local_model_sha_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/local_model_sha_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/local_model_sha_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textNoSuggestions"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_simple_local_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pref_use_simple_local_prompt"
        android:checked="true"
        style="@style/Widget.Material3.CompoundButton.MaterialSwitch"
        android:layout_marginTop="16dp" />

</LinearLayout>
